# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: [
    {
      name: "airDate"
      req: false
      short: "Original air date of the episode"
      type: "`$STRING`"
    }
    {
      name: "director"
      req: false
      short: "Director of the episode"
      type: "`$STRING`"
    }
    {
      name: "episodeNum"
      req: false
      short: "Episode number"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the episode"
      type: "`$INTEGER`"
    }
    {
      name: "season"
      req: false
      short: "Season number"
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: false
      short: "Title of the episode"
      type: "`$STRING`"
    }
    {
      name: "writer"
      req: false
      short: "Writer of the episode"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/episodes"
          segments: [
            {
              lit: "episodes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/episodes/{id}"
          segments: [
            {
              lit: "episodes"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
