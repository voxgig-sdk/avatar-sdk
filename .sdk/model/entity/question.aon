# Entity: question

main: kit: entity: question: {

  alias: field: {}

  fields: [
    {
      name: "answer"
      req: false
      short: "The correct answer to the trivia question"
      type: "`$STRING`"
    }
    {
      name: "difficulty"
      req: false
      short: "Difficulty level of the question"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the trivia question"
      type: "`$INTEGER`"
    }
    {
      name: "question"
      req: false
      short: "The trivia question text"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "question"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/questions"
          segments: [
            {
              lit: "questions"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/questions/{id}"
          segments: [
            {
              lit: "questions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
